{
  "name": "constructor-with-react",
  "version": "0.1",
  "private": true,
  "description": "Constructor is a helpful tool designed for the HTML team to streamline the creation of newsletters and landing pages. It supports localization by integrating with a translations spreadsheet, making it easier to build content for multiple languages.",
  "type": "module",
  "main": "app.js",
  "scripts": {
    "dev": "webpack serve --mode development",
    "format": "prettier --write \"src/**/*.{js,jsx,ts,tsx,css,scss,md,json}\""
  },
  "dependencies": {
    "googleapis": "^150.0.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@babel/core": "^7.27.4",
    "@babel/preset-env": "^7.27.2",
    "@babel/preset-react": "^7.27.1",
    "@types/react": "^19.1.7",
    "babel-loader": "^10.0.0",
    "css-loader": "^7.1.2",
    "prettier": "^3.5.3",
    "sass": "^1.89.2",
    "sass-loader": "^16.0.5",
    "style-loader": "^4.0.0",
    "webpack": "^5.99.9",
    "webpack-cli": "^6.0.1",
    "webpack-dev-server": "^5.2.2"
  },
  "packageManager": "pnpm@10.11.0"
}
